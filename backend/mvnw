#!/bin/sh
# Maven Wrapper script

set -e

# Download Maven if not present
MAVEN_HOME="${HOME}/.m2/wrapper/dists/apache-maven-3.9.5"
if [ ! -d "$MAVEN_HOME" ]; then
    mkdir -p "$MAVEN_HOME"
    cd "$MAVEN_HOME"
    wget -q https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/3.9.5/apache-maven-3.9.5-bin.tar.gz
    tar -xzf apache-maven-3.9.5-bin.tar.gz --strip-components=1
    rm apache-maven-3.9.5-bin.tar.gz
fi

export PATH="$MAVEN_HOME/bin:$PATH"
exec mvn "$@"
